{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UiEvaluation",
  "type": "object",
  "required": [
    "use_cases",
    "findings"
  ],
  "properties": {
    "use_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "case_ids",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "missing"
            ]
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "blocking",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
