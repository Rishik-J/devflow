#!/bin/sh
# Docker-only local observability bootstrap. Agent authentication stays on the host.
set -eu
umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
INFRA="$ROOT/infra/langfuse"
IMAGE=devflow-observability-setup:local

usage() {
    cat <<'HELP'
Usage: ./scripts/observability [up|connect] [--capture-content] [REPO ...]
       ./scripts/observability [status|stop|logs]

up       Generate/reuse private credentials, connect repositories, start local Langfuse.
connect  Connect repositories without starting or restarting the stack.
status   Show the local stack status.
stop     Stop containers while preserving data.
logs     Follow Langfuse web/worker logs.

The default repository is this devflow checkout. Paths may contain spaces.
--capture-content opts repositories into redacted prompt, response and tool capture.
Existing capture settings are preserved when the flag is omitted.
Requires Docker with Compose v2; no host Python is needed for this setup.
HELP
}

ACTION=${1:-up}
if [ "$#" -gt 0 ]; then shift; fi
case "$ACTION" in
    -h|--help|help) usage; exit 0 ;;
    up|connect|status|stop|logs) ;;
    *) usage >&2; exit 2 ;;
esac
if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Install/start Docker Desktop or Docker Engine with Compose v2.' >&2
    exit 1
fi
docker compose version >/dev/null
docker info >/dev/null

compose() {
    docker compose -f "$INFRA/compose.yaml" --env-file "$INFRA/.env" "$@"
}
case "$ACTION" in
    up|connect)
        CAPTURE=
        if [ "${1:-}" = --capture-content ]; then CAPTURE=--capture-content; shift; fi
        if [ "$#" -eq 0 ]; then set -- "$ROOT"; fi
        # Validate all destinations before creating credentials or touching repositories.
        for REPO in "$@"; do
            if [ ! -d "$REPO" ] || [ ! -e "$REPO/.git" ]; then
                echo "Not a git checkout: $REPO" >&2
                exit 2
            fi
        done
        docker build --tag "$IMAGE" "$INFRA"
        for REPO in "$@"; do
            REPO=$(CDPATH= cd -- "$REPO" && pwd -P)
            # Same absolute path inside/outside keeps trace log paths valid on the host.
            # Run as the caller so Linux users do not get root-owned repository files.
            if [ -n "$CAPTURE" ]; then
                docker run --rm --user "$(id -u):$(id -g)" \
                    -v "$INFRA:$INFRA" -v "$REPO:$REPO" \
                    "$IMAGE" --data-dir "$INFRA" --capture-content "$REPO"
            else
                docker run --rm --user "$(id -u):$(id -g)" \
                    -v "$INFRA:$INFRA" -v "$REPO:$REPO" \
                    "$IMAGE" --data-dir "$INFRA" "$REPO"
            fi
        done
        if [ "$ACTION" = up ]; then
            compose up -d --wait --wait-timeout 240
            echo 'Langfuse is ready at http://localhost:3300 (project: Devflow Workflows).'
        fi
        echo "Login details: $INFRA/login.json"
        ;;
    status|stop|logs)
        if [ "$#" -ne 0 ]; then usage >&2; exit 2; fi
        if [ ! -f "$INFRA/.env" ]; then
            echo 'Run ./scripts/observability up first.' >&2
            exit 1
        fi
        case "$ACTION" in
            status) compose ps ;;
            stop) compose stop ;;
            logs) compose logs --follow --tail 100 langfuse-web langfuse-worker ;;
        esac
        ;;
esac
